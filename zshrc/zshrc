# All the time I want the path of a real file to hand to claude
cppath() {
    local full
    full=$(realpath "$1")
    if [[ "$full" == "$HOME"/* ]]; then
      echo "${full/#$HOME/~}" | pbcopy
      echo "Copied ${full/#$HOME/~} to your past buffer"
    else
      echo "$full" | pbcopy
      echo "Copied $full to your paste buffer"
    fi
  }


