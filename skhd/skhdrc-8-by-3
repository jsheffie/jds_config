# === 2D Grid Navigation (8 wide × 3 tall) ===
# Row 1: D1  D2  D3  D4  D5  D6  D7  D8
# Row 2: D9  D10 D11 D12 D13 D14 D15 D16
# Row 3: D17 D18 D19 D20 D21 D22 D23 D24

# Move right: next space within row (stops at col 8: indices 8, 16, 24)
ctrl - right : idx=$(/opt/homebrew/bin/yabai -m query --spaces --space | /opt/homebrew/bin/jq '.index'); if [ $(( ($idx - 1) % 8 )) -lt 7 ]; then /opt/homebrew/bin/yabai -m space --focus next; fi

# Move left: previous space within row (stops at col 1: indices 1, 9, 17)
ctrl - left : idx=$(/opt/homebrew/bin/yabai -m query --spaces --space | /opt/homebrew/bin/jq '.index'); if [ $(( ($idx - 1) % 8 )) -gt 0 ]; then /opt/homebrew/bin/yabai -m space --focus prev; fi

# Move down: jump forward 8 (D1→D9, D9→D17, etc.)
ctrl - down : /opt/homebrew/bin/yabai -m space --focus "$(($(/opt/homebrew/bin/yabai -m query --spaces --space | /opt/homebrew/bin/jq '.index') + 8))"

# Move up: jump back 8 (D9→D1, D17→D9, etc.)
ctrl - up : /opt/homebrew/bin/yabai -m space --focus "$(($(/opt/homebrew/bin/yabai -m query --spaces --space | /opt/homebrew/bin/jq '.index') - 8))"

# Direct jumps: Row 1 (Ctrl+1..8 → D1..D8)
ctrl - 1 : /opt/homebrew/bin/yabai -m space --focus 1
ctrl - 2 : /opt/homebrew/bin/yabai -m space --focus 2
ctrl - 3 : /opt/homebrew/bin/yabai -m space --focus 3
ctrl - 4 : /opt/homebrew/bin/yabai -m space --focus 4
ctrl - 5 : /opt/homebrew/bin/yabai -m space --focus 5
ctrl - 6 : /opt/homebrew/bin/yabai -m space --focus 6
ctrl - 7 : /opt/homebrew/bin/yabai -m space --focus 7
ctrl - 8 : /opt/homebrew/bin/yabai -m space --focus 8

# Direct jumps: Row 2 (Ctrl+alt+q..i → D9..D16)
ctrl + alt - q : /opt/homebrew/bin/yabai -m space --focus 9
# ctrl w is a keystroke for closing chrome window
ctrl + alt - w : /opt/homebrew/bin/yabai -m space --focus 10
# ctrl - e is a common (go to end of line keymap)
ctrl + alt - e : /opt/homebrew/bin/yabai -m space --focus 11
ctrl + alt - r : /opt/homebrew/bin/yabai -m space --focus 12
ctrl + alt - t : /opt/homebrew/bin/yabai -m space --focus 13
ctrl + alt - y : /opt/homebrew/bin/yabai -m space --focus 14
ctrl + alt - u : /opt/homebrew/bin/yabai -m space --focus 15
ctrl + alt - i : /opt/homebrew/bin/yabai -m space --focus 16

# Direct jumps: Row 3 (Ctrl+alt+a..k → D17..D24)  (home row, stops before l)
ctrl + alt - a : /opt/homebrew/bin/yabai -m space --focus 17
ctrl + alt - s : /opt/homebrew/bin/yabai -m space --focus 18
ctrl + alt - d : /opt/homebrew/bin/yabai -m space --focus 19
ctrl + alt - f : /opt/homebrew/bin/yabai -m space --focus 20
ctrl + alt - g : /opt/homebrew/bin/yabai -m space --focus 21
ctrl + alt - h : /opt/homebrew/bin/yabai -m space --focus 22
ctrl + alt - j : /opt/homebrew/bin/yabai -m space --focus 23
ctrl + alt - k : /opt/homebrew/bin/yabai -m space --focus 24
