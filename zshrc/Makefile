PUBLIC=/Users/jds/workspace/jds_config/zshrc/zshrc
PRIVATE=/Users/jds/workspace/jds_private_config/zshrc_private/zshrc
TARGET=~/.zshrc

install:
	@echo "# Generated by jds_config/zshrc/Makefile on $$(date)" > $(TARGET)
	@echo "# Do not edit directly — edit the source files and run make install" >> $(TARGET)
	@echo "" >> $(TARGET)
	@cat $(PUBLIC) >> $(TARGET)
	@echo "" >> $(TARGET)
	@cat $(PRIVATE) >> $(TARGET)
	@echo "Generated ~/.zshrc from public + private sources"

.PHONY: install
